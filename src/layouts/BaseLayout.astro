---
import "@fontsource/dm-sans/400.css";
import "@fontsource/dm-sans/500.css";
import "@fontsource/dm-sans/600.css";
import "@fontsource/dm-sans/700.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalPath?: string;
  article?: boolean;
}

const {
  title,
  description,
  image,
  canonicalPath = Astro.url.pathname,
  article = false,
} = Astro.props;
const siteURL = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || "http://localhost:4321";
const canonicalURL = new URL(canonicalPath, siteURL).toString();
const imageURL = image ? new URL(image, siteURL).toString() : undefined;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    <meta
      name="twitter:card"
      content={imageURL ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={base} aria-label="Laya Case 首页">
          <span class="brand-mark">LAYA</span>
          <span class="brand-name">CASE</span>
        </a>
        <div class="header-meta">
          <span class="live-dot" aria-hidden="true"></span>
          <span>开源案例索引</span>
        </div>
        <nav class="header-nav" aria-label="主导航">
          <label class="translation-switch">
            <input type="checkbox" aria-label="中文翻译" />
            <span class="translation-option translation-original">原文</span>
            <span class="translation-option translation-chinese">中文</span>
          </label>
          <a href={base}>案例</a>
          <a
            href="https://huggingface.co/convaiinnovations/laya"
            target="_blank"
            rel="noopener noreferrer"
          >
            HuggingFace
          </a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>
          非官方社区整理，与 Convai Innovations / Laya
          无隶属关系。案例内容、代码与商标权利归原作者及原平台所有；站点代码基于
          Jev-Case（MIT）。
        </p>
        <p class="footer-tech">OPEN CASE INDEX / DATA ONLY / ORIGINALS LINKED</p>
      </footer>
    </div>
  </body>
</html>
