---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Case not found | Laya Case" description="没有找到这条案例。">
  <section class="empty-state full">
    <p class="eyebrow">404 / CASE LOST</p>
    <h1>这条案例不存在。</h1>
    <a class="source-button compact" href={base}>返回案例流</a>
  </section>
</BaseLayout>
