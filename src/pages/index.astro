---
import CaseWall from "../components/react/CaseWall";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCases, getGeneratedAt } from "../lib/cases";

const cases = getCases();
// Data-derived timestamp keeps builds reproducible (no wall-clock in output).
const scoreReferenceTime = getGeneratedAt();
---

<BaseLayout
  title="Laya Case | Laya vs Jev · 开源 System 1 案例墙"
  description="浏览 GitHub、HuggingFace、Reddit 与博客上基于开源模型 Laya（System 1 决策模型、Jev 开源替代）的公开案例、Laya vs Jev 对比实测、可运行代码与讨论。"
>
  <CaseWall
    cases={cases}
    scoreReferenceTime={scoreReferenceTime}
    client:load
  />
</BaseLayout>
