---
import CaseWall from "../components/react/CaseWall";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCases } from "../lib/cases";

const cases = getCases();
const scoreReferenceTime = new Date().toISOString();
---

<BaseLayout
  title="Laya Case | 开源 System 1 案例墙"
  description="浏览 GitHub、HuggingFace、Reddit 与博客上基于开源模型 Laya（System 1 决策模型）的公开案例、可运行代码与讨论。"
>
  <CaseWall
    cases={cases}
    scoreReferenceTime={scoreReferenceTime}
    client:load
  />
</BaseLayout>
